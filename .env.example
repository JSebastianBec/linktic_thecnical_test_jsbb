# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_DB=linktic_db
POSTGRES_USER=app_user
POSTGRES_PASSWORD=changeme

# ─── RabbitMQ ────────────────────────────────────────────────────────────────
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# ─── Security ────────────────────────────────────────────────────────────────
API_KEY=your-secret-api-key

# ─── Frontend ────────────────────────────────────────────────────────────────
# En desarrollo apunta directo al nginx local.
# En Docker, Nginx hace el proxy internamente y esta variable no se usa.
VITE_API_BASE_URL=http://localhost:9000
